  "types": [
    {
      "name": "Budget",
      "docs": [
        "A budget node in the tree. Pure accounting; money lives in the project vault.",
        "PDA: [\"budget\", project, agent]  (one node per agent key per project)."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "project",
            "type": "pubkey"
          },
          {
            "name": "parent",
            "docs": [
              "None == root."
            ],
            "type": {
              "option": "pubkey"
            }
          },
          {
            "name": "agent",
            "docs": [
              "The key that authorizes `spend` and `allocate_child` for this node."
            ],
            "type": "pubkey"
          },
          {
            "name": "label",
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "depth",
            "docs": [
              "Root = 0."
            ],
            "type": "u8"
          },
          {
            "name": "can_delegate",
            "docs": [
              "Whether this node may create children."
            ],
            "type": "bool"
          },
          {
            "name": "max_child_depth",
            "docs": [
              "Maximum absolute depth allowed anywhere in this node's subtree."
            ],
            "type": "u8"
          },
          {
            "name": "allocated",
            "docs": [
              "Total allocated to this node."
            ],
            "type": "u64"
          },
          {
            "name": "spent",
            "docs": [
              "Spent by this node itself."
            ],
            "type": "u64"
          },
          {
            "name": "reserved_for_children",
            "docs": [
              "Reserved (allocated out) to children."
            ],
            "type": "u64"
          },
          {
            "name": "per_tx_limit",
            "docs": [
              "None == no per-transaction cap."
            ],
            "type": {
              "option": "u64"
            }
          },
          {
            "name": "period_limit",
            "docs": [
              "None == no rolling-period cap."
            ],
            "type": {
              "option": "u64"
            }
          },
          {
            "name": "period_seconds",
            "docs": [
              "Length of the rolling period in seconds (<= 0 means no period cap)."
            ],
            "type": "i64"
          },
          {
            "name": "period_start",
            "docs": [
              "Start of the current rolling window (unix seconds)."
            ],
            "type": "i64"
          },
          {
            "name": "period_spent",
            "docs": [
              "Spent within the current rolling window."
            ],
            "type": "u64"
          },
          {
            "name": "expires_at",
            "docs": [
              "None == never expires."
            ],
            "type": {
              "option": "i64"
            }
          },
          {
            "name": "status",
            "type": {
              "defined": {
                "name": "BudgetStatus"
              }
            }
          },
          {
            "name": "allowlist",
            "docs": [
              "Allowed recipient wallets. `allowlist_len == 0` means any recipient allowed."
            ],
            "type": {
              "array": [
                "pubkey",
                8
              ]
            }
          },
          {
            "name": "allowlist_len",
            "type": "u8"
          },
          {
            "name": "children_count",
            "type": "u16"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },

{
  "name": "quaestor",
  "version": "0.0.1",
  "private": true,
  "description": "Hierarchical, on-chain-enforced budgets for AI agents on Solana. Give agents budgets, not keys.",
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:program": "anchor build",
    "build:sdk": "pnpm --filter @quaestor/sdk build",
    "test:program": "bash scripts/test.sh",
    "test:sdk": "bash scripts/test-sdk.sh",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@quaestor/sdk": "workspace:*"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.9",
    "@types/node": "^22.7.4",
    "chai": "^4.5.0",
    "mocha": "^10.7.3",
    "prettier": "^3.3.3",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}

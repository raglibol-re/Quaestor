# Copy to .env and fill in. NEVER commit real keys.

# --- Solana ---
SOLANA_CLUSTER=devnet
ANCHOR_PROVIDER_URL=https://api.devnet.solana.com
ANCHOR_WALLET=~/.config/solana/id.json
QUAESTOR_PROGRAM_ID=FVytqbLtyRAqshYkP8iacSGHbdT53tZNiLmoTG9Xu5dP

# --- Test USDC mint (self-minted on devnet; filled by scripts) ---
QUAESTOR_USDC_MINT=

# --- MCP server (M3) ---
# Which chain this MCP instance targets: solana (default) | tempo | base | hyperliquid
QUAESTOR_CHAIN=solana
# Which agent this MCP instance acts as (name in the local keystore)
QUAESTOR_AGENT=
# Passphrase used to decrypt the local agent keystore (~/.quaestor/keys)
QUAESTOR_KEYSTORE_PASSPHRASE=
# Relayer keypair path (Solana: pays fees + rent so agents need no SOL)
QUAESTOR_RELAYER_KEYPAIR=
# Solana project PDA (base58) this instance manages
QUAESTOR_PROJECT=
# Solana RPC — set to the RPC Fast devnet endpoint (Superteam sidetrack); defaults to devnet public
QUAESTOR_RPC_URL=
# Spend-attribution plaintext log (task_id + reason, keyed by tx signature).
# Defaults to ~/.quaestor/attribution.jsonl; a hash of the reason is written on-chain.
QUAESTOR_ATTRIBUTION_LOG=

# --- EVM chains (M8–M11): Tempo testnet + Base Sepolia ---
# EVM RPC for the selected chain
QUAESTOR_EVM_RPC_URL=
# Deployed Quaestor.sol address + ERC-2771 forwarder + chain id
QUAESTOR_CONTRACT=
QUAESTOR_FORWARDER=
QUAESTOR_CHAIN_ID=
# EVM project key (bytes32) this instance manages
QUAESTOR_EVM_PROJECT=
# Relayer private key (EVM: pays gas; forwards agents' signed meta-txns so agents hold no gas)
QUAESTOR_EVM_RELAYER_KEY=

# --- Contract deploys (forge) ---
# Deployer key for `forge script Deploy.s.sol` / `DeployDesk.s.sol` (Base Sepolia / Tempo / HyperEVM)
PRIVATE_KEY=
# Optional existing USDC to use instead of deploying a MockUSDC
USDC=

# --- Hyperliquid trading desk (QuaestorDesk) ---
# HyperEVM testnet RPC (https://rpc.hyperliquid-testnet.xyz/evm). Enable big-block mode for the
# deployer before deploying (QuaestorDesk is a large contract). Precompile/CoreWriter addresses
# in QuaestorDesk.sol are HyperCore system addresses — VERIFY exact values from the HL docs.
QUAESTOR_DESK_RPC_URL=
QUAESTOR_DESK_CONTRACT=
QUAESTOR_DESK_FORWARDER=

# Quaestor remote connector — server-side secrets & config (Vercel env / .env.local).
# NEVER commit real values. The connector serves ONE Solana project (single-tenant per deploy).

# --- Public config ---
QUAESTOR_CHAIN=solana
QUAESTOR_RPC_URL=https://api.devnet.solana.com
# The project PDA this connector serves (base58). Its on-chain owner gates consent.
QUAESTOR_PROJECT=
# Public HTTPS base URL of this deployment (OAuth issuer + resource identifier). No trailing slash.
QUAESTOR_CONNECTOR_URL=https://quaestor-connector.vercel.app
# Comma-separated extra allowed OAuth redirect URIs (claude.ai's is always allowed).
QUAESTOR_ALLOWED_REDIRECTS=

# --- Secrets ---
# Neon Postgres connection string (carries a role password).
DATABASE_URL=
# Relayer that pays fees/rent so agents need no SOL. Base58 secret key OR a JSON [u8;64] array.
QUAESTOR_RELAYER_SECRET=
# Dev envelope master key for custody (base64 of 32 random bytes). Swap to AWS KMS in prod.
QUAESTOR_MASTER_KEY=
# HMAC key for signing access-token JWTs (base64 of >=32 random bytes).
QUAESTOR_JWT_SECRET=
# Optional per-call x402 ceiling (decimal USDC) enforced server-side.
QUAESTOR_X402_MAX_USDC=

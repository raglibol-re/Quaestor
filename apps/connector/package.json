    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "jose": "^5.9.6",
    "next": "^15.5.4",
    "process": "^0.11.10",
    "react": "^18.3.1",
